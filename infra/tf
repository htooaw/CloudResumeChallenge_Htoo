#!/bin/bash
set -e

ENV="$1"
shift

case "$ENV" in
  prod)
    export AWS_PROFILE=haw-sandbox
    WORKSPACE=cloudresumechallenge-haw-prod
    TFVARS=prod.tfvars
    ;;
  test)
    export AWS_PROFILE=haw-test
    WORKSPACE=cloudresumechallenge-haw-test
    TFVARS=test.tfvars
    ;;
  *)
    echo "Usage: ./tf {prod|test} <terraform-command> [args...]"
    exit 1
    ;;
esac

terraform workspace select "$WORKSPACE" > /dev/null

if [ "$ENV" = "prod" ]; then
  echo -e "\033[1;31m→ workspace: $WORKSPACE\033[0m"
  echo -e "\033[1;31m→ AWS_PROFILE: $AWS_PROFILE\033[0m"
else
  echo -e "\033[1;32m→ workspace: $WORKSPACE\033[0m"
  echo -e "\033[1;32m→ AWS_PROFILE: $AWS_PROFILE\033[0m"
fi
echo

case "$1" in
  plan|apply|destroy|refresh|import)
    terraform "$@" -var-file="$TFVARS"
    ;;
  *)
    terraform "$@"
    ;;
esac