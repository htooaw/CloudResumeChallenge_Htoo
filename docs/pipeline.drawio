<mxfile host="app.diagrams.net"><diagram id="pipeline" name="Pipeline"><mxGraphModel dx="1400" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c11" value="&lt;b&gt;GitLab CI pipeline&lt;/b&gt; · every push to main that changes code" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#111827;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="520" height="24" as="geometry"/></mxCell><mxCell id="c12" value="Test account" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;verticalAlign=top;align=left;spacingLeft=30;fontSize=12;fontStyle=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;strokeColor=#3F8624;fontColor=#3F8624;fillColor=#F3FAF0;dashed=1;" vertex="1" parent="1"><mxGeometry x="285" y="75" width="1000" height="150" as="geometry"/></mxCell><mxCell id="c13" value="Prod account" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;verticalAlign=top;align=left;spacingLeft=30;fontSize=12;fontStyle=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;strokeColor=#CD2264;fontColor=#CD2264;fillColor=#FDF2F7;" vertex="1" parent="1"><mxGeometry x="35" y="280" width="1250" height="150" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;git push&lt;/b&gt; to main" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FC6D26;strokeColor=#E24329;fontColor=#FFFFFF;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="85" y="62" width="150" height="36" as="geometry"/></mxCell><mxCell id="c15" value="&lt;span style=&quot;font-family:Menlo,Consolas,monospace;font-size:13px;font-weight:bold;color:#111827&quot;&gt;unit_test&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#6B7280&quot;&gt;pytest + moto&lt;br&gt;no AWS access needed&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FC6D26;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="125" width="200" height="72" as="geometry"/></mxCell><mxCell id="c16" value="&lt;span style=&quot;font-family:Menlo,Consolas,monospace;font-size:13px;font-weight:bold;color:#111827&quot;&gt;apply_test&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#6B7280&quot;&gt;terraform apply&lt;br&gt;outputs → deploy.env&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3F8624;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="310" y="125" width="200" height="72" as="geometry"/></mxCell><mxCell id="c17" value="&lt;span style=&quot;font-family:Menlo,Consolas,monospace;font-size:13px;font-weight:bold;color:#111827&quot;&gt;build_test&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#6B7280&quot;&gt;next build with&lt;br&gt;the test API URL&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3F8624;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="560" y="125" width="200" height="72" as="geometry"/></mxCell><mxCell id="c18" value="&lt;span style=&quot;font-family:Menlo,Consolas,monospace;font-size:13px;font-weight:bold;color:#111827&quot;&gt;deploy_test&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#6B7280&quot;&gt;account check · s3 sync&lt;br&gt;CloudFront invalidation&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3F8624;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="810" y="125" width="200" height="72" as="geometry"/></mxCell><mxCell id="c19" value="&lt;span style=&quot;font-family:Menlo,Consolas,monospace;font-size:13px;font-weight:bold;color:#111827&quot;&gt;smoke_test&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#6B7280&quot;&gt;Playwright&lt;br&gt;5 browser tests&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3F8624;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1060" y="125" width="200" height="72" as="geometry"/></mxCell><mxCell id="c20" value="&lt;span style=&quot;font-family:Menlo,Consolas,monospace;font-size:13px;font-weight:bold;color:#111827&quot;&gt;plan_prod&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#6B7280&quot;&gt;terraform plan&lt;br&gt;I read the diff&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CD2264;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="200" height="72" as="geometry"/></mxCell><mxCell id="c21" value="&lt;span style=&quot;font-family:Menlo,Consolas,monospace;font-size:13px;font-weight:bold;color:#9A3412&quot;&gt;▶ apply_prod&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#9A3412&quot;&gt;manual · one click&lt;br&gt;outputs → deploy.env&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=2.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="310" y="330" width="200" height="72" as="geometry"/></mxCell><mxCell id="c22" value="&lt;span style=&quot;font-family:Menlo,Consolas,monospace;font-size:13px;font-weight:bold;color:#111827&quot;&gt;build_prod&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#6B7280&quot;&gt;next build with&lt;br&gt;the prod API URL&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CD2264;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="560" y="330" width="200" height="72" as="geometry"/></mxCell><mxCell id="c23" value="&lt;span style=&quot;font-family:Menlo,Consolas,monospace;font-size:13px;font-weight:bold;color:#111827&quot;&gt;deploy_prod&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#6B7280&quot;&gt;account check · s3 sync&lt;br&gt;CloudFront invalidation&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CD2264;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="810" y="330" width="200" height="72" as="geometry"/></mxCell><mxCell id="c24" value="&lt;span style=&quot;font-family:Menlo,Consolas,monospace;font-size:13px;font-weight:bold;color:#111827&quot;&gt;smoke_prod&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#6B7280&quot;&gt;Playwright against&lt;br&gt;htooaungwin.com&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CD2264;strokeWidth=1.5;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1060" y="330" width="200" height="72" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#374151;strokeWidth=1.5;fontSize=11;fontColor=#374151;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#374151;strokeWidth=1.5;fontSize=11;fontColor=#374151;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#374151;strokeWidth=1.5;fontSize=11;fontColor=#374151;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#374151;strokeWidth=1.5;fontSize=11;fontColor=#374151;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1"