ay></mxGeometry></mxCell><mxCell id="c35" value="&lt;span style=&quot;font-family:Menlo,Consolas,monospace;font-weight:bold&quot;&gt;destroy_test&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#6B7280&quot;&gt;manual, runs on its own&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F9FAFB;strokeColor=#9CA3AF;dashed=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="462" width="200" height="52" as="geometry"/></mxCell><mxCell id="c36" value="Every job that touches AWS logs in with OIDC, so no AWS keys are stored in GitLab.&lt;br&gt;If any job fails, every job after it stops. Merge requests run unit_test only." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#374151;fontFamily=Helvetica;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="300" y="462" width="760" height="52" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>